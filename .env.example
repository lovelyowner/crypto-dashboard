# Development needs none of these. Configure server-side for production.
# DATABASE_URL=
# BETTER_AUTH_URL=https://dashboard.example.com
# BETTER_AUTH_SECRET=   # generate a stable random secret >=32 characters
# Optional mail delivery
# RESEND_API_KEY=
# AUTH_EMAIL_FROM=Fathom <accounts@example.com>
# Optional OAuth applications (server-only; never VITE_)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=
# PGLITE_DATA_DIR=./.data/fathom
