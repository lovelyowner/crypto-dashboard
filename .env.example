# Development needs none of these. Configure server-side in Vercel for hosted accounts.
# Never use VITE_ for credentials; redeploy after changing variables.
# Profile links, wishlists, public shares and local wallets work without these.
# DATABASE_URL=
# BETTER_AUTH_URL=https://dashboard.example.com # exact origin, no path
# BETTER_AUTH_SECRET=   # generate a stable random secret >=32 characters
# Vercel non-production deployments (including missing VERCEL_ENV) ignore all
# three generic variables above. Leave these unset for a browser-only preview.
# To enable preview accounts/migrations, set ALL THREE to isolated preview values.
# Never reuse the production database or secret. Use a stable HTTPS preview origin.
# PREVIEW_DATABASE_URL=
# PREVIEW_BETTER_AUTH_URL=https://preview-dashboard.example.com
# PREVIEW_BETTER_AUTH_SECRET=   # a different stable random secret >=32 characters
# Optional moderation reviewers: comma-separated internal account user IDs, never VITE_.
# MODERATION_REVIEWER_IDS=
# Optional mail delivery
# RESEND_API_KEY=
# AUTH_EMAIL_FROM=Fathom <accounts@example.com>
# Optional OAuth applications (server-only; never VITE_)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=
# PGLITE_DATA_DIR=./.data/fathom

# Optional server-only read-only Ethereum mainnet RPC for verified paid messages
# ETHEREUM_PAYMENTS_RPC_URL=https://ethereum-rpc.publicnode.com
# Each creator saves NOWPayments credentials privately in the app, never VITE_ or public profile data.
